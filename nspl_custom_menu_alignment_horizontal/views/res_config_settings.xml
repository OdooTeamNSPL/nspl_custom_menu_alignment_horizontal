<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_menu_layout_horizontal" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.menu.layout</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='user_default_rights']" position="after">
                    <block title="Menu Layout Settings Horizontal" id="menu_layout_block_horizontal">
                        <field name="menu_layout_horizontal"
                               widget="radio"
                               string="Select Menu Layout"
                               help="Choose how you want the main menu to be displayed in the backend interface."
                               groups="base.group_system"/>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
